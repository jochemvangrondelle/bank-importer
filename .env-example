# Bank Importer TH - Environment Variables Example
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed to the repository
#
# For GitHub Actions CI/CD:
# 1. Go to your repository Settings > Secrets and variables > Actions
# 2. Add the following secrets:
#    - SENTRY_DSN (for general Python/CLI error tracking)
#    - API_SENTRY_DSN (optional, for API-specific error tracking)
# 3. These secrets will be available as environment variables in workflows

# =============================================================================
# Sentry Configuration (Error Tracking)
# =============================================================================

# General Python/CLI Sentry DSN
# Get your DSN from: https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
SENTRY_DSN=https://YOUR_PUBLIC_KEY@o4510334484545536.ingest.de.sentry.io/YOUR_PROJECT_ID

# Sentry configuration options (optional, defaults shown)
SENTRY_SEND_DEFAULT_PII=true
SENTRY_ENABLE_LOGS=true
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0

# =============================================================================
# API-specific Sentry Configuration (optional, uses SENTRY_* if not set)
# =============================================================================

# API Sentry DSN (if different from general Sentry DSN)
# API_SENTRY_DSN=https://YOUR_API_PUBLIC_KEY@o4510334484545536.ingest.de.sentry.io/YOUR_API_PROJECT_ID

# API Sentry configuration options (optional, defaults shown)
# API_SENTRY_SEND_DEFAULT_PII=true
# API_SENTRY_ENABLE_LOGS=true
# API_SENTRY_TRACES_SAMPLE_RATE=1.0
# API_SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
# API_SENTRY_PROFILE_LIFECYCLE=trace

# =============================================================================
# OpenTelemetry Configuration (optional)
# =============================================================================

# OTEL_SERVICE_NAME=bank-importer
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint.com
# OTEL_EXPORTER_OTLP_HEADERS=api-key=your-key
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp

# =============================================================================
# API Configuration (optional)
# =============================================================================

# API_HOST=0.0.0.0
# API_PORT=8000
# JWT_SECRET_KEY=your-secret-key-change-in-production
# CORS_ORIGINS=http://localhost:3000,https://example.com
