{
  "name": "bank-importer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "check:duplicates": "jscpd src --min-lines 5 --min-tokens 50",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:coverage": "playwright test && npm run coverage:check",
    "coverage:check": "node scripts/check-coverage.js",
    "coverage:report": "playwright show-report",
    "test:ci": "npm run type-check && npm run lint && npm run test:e2e:coverage",
    "generate:api": "openapi-typescript-codegen --input ../api/openapi.yaml --output ./src/api/generated --client axios",
    "check:api-client": "scripts/check-api-client.sh",
    "prepare": "husky install"
  },
  "dependencies": {
    "@refinedev/core": "^4.45.0",
    "@refinedev/react-router-v6": "^4.5.0",
    "@refinedev/antd": "^5.33.0",
    "@refinedev/simple-rest": "^4.5.0",
    "@refinedev/kbar": "^1.1.0",
    "antd": "^5.20.0",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.23.8",
    "react-pdf": "^9.1.0",
    "pdfjs-dist": "^4.0.379"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.12.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-secrets": "^0.8.9",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^56.0.1",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "msw": "^2.0.0",
    "openapi-typescript-codegen": "^0.25.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "yaml": "^2.4.0"
  }
}
